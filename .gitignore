# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Video/audio/image assets — this repo only ever produces/stores these as
# generated or downloaded footage/logos/merch photos (footage/, output/,
# cache/, channels/), never as something meant to be committed.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Generated output and local state. The code that produces these is
# tracked; what it produces is not. footage/ is a data directory now —
# the tools that maintain it live in tools/ — so only its metadata
# (manifest.json, kept as an import backup) stays in the repo.
output/
cache/
channels/
deleted_channels/
job_state/
footage/library.db
footage/library.db-wal
footage/library.db-shm

# Per-installation and per-run state, not shared between checkouts.
config/cost_log.jsonl
config/script_history.json
config/schedule.json
config/channels.json.v1.bak

# Test and tooling caches
.pytest_cache/
.coverage

# Env/secrets
.env
.env.*

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
